<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <GeneDef ParentName="GeneHandsBase">
        <defName>OCARINA_MantledBeastsPaws</defName>
        <label>va'ji paws</label>
        <description>Fluffy paws with pads at the ends of one's arms and legs. Consisting of either four fingers (including thumb) or four toes, these paws help with overall speed and stealth, with the sharp claws at the ends allowing for greater protection.</description>
        <iconPath>UI/Icons/Genes/Gene_MantledBeastsPaws</iconPath>
        <displayOrderInCategory>320</displayOrderInCategory>
        <biostatCpx>4</biostatCpx>
        <biostatMet>-2</biostatMet>
        <displayCategory>OCARINA_Cosmetic_MantledBeasts</displayCategory>
        <capMods>
            <li>
                <capacity>Manipulation</capacity>
                <postFactor>0.95</postFactor>
            </li>
        </capMods>
        <statOffsets>
            <HuntingStealth>0.17</HuntingStealth>
            <MoveSpeed>0.05</MoveSpeed>
        </statOffsets>
        <statFactors>
            <MoveSpeed>1.1</MoveSpeed>
            <VEF_MassCarryCapacity>0.80</VEF_MassCarryCapacity>
            <CarryingCapacity>0.80</CarryingCapacity>
        </statFactors>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>pawed</symbol>
                </li>
            </prefixSymbols>
        </symbolPack>
        <modExtensions>
            <li Class="MantledBeasts.GeneExtension">
                <backgroundPathEndogenes>UI/Icons/Genes/AG_Endogenes</backgroundPathEndogenes>
                <backgroundPathXenogenes>UI/Icons/Genes/AG_Xenogenes</backgroundPathXenogenes>
                <hediffsToBodyPartsOnce>
                    <li>
                        <hediff>OCARINA_MantledBeastsPaws</hediff>
                        <bodyparts>
                            <li>Hand</li>
                            <li>Hand</li>
                        </bodyparts>
                    </li>
                </hediffsToBodyPartsOnce>
            </li>
        </modExtensions>
    </GeneDef>

    <GeneDef>
        <defName>OCARINA_MantledBeastsEyesight</defName>
        <label>va'ji eyesight</label>
        <description>Carriers of this gene have particularly poor eyesight.</description>
        <iconPath>UI/Icons/Genes/Gene_MantledBeastsEyes</iconPath>
        <displayCategory>OCARINA_Cosmetic_MantledBeasts</displayCategory>
        <displayOrderInCategory>51</displayOrderInCategory>
        <biostatMet>4</biostatMet>
        <biostatCpx>3</biostatCpx>
        <selectionWeight>0</selectionWeight>
        <exclusionTags>
            <li>ShootingAccuracy</li>
            <li>EyeColor</li>
        </exclusionTags>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>blind</symbol>
                </li>
                <li>
                    <symbol>blur</symbol>
                </li>
                <li>
                    <symbol>squint</symbol>
                </li>
                <li>
                    <symbol>peek</symbol>
                </li>
                <li>
                    <symbol>cross</symbol>
                </li>
            </prefixSymbols>
            <suffixSymbols>
                <li>
                    <symbol>sighter</symbol>
                </li>
                <li>
                    <symbol>peeker</symbol>
                </li>
            </suffixSymbols>
        </symbolPack>
        <modExtensions>
            <li Class="MantledBeasts.GeneExtension">
                <backgroundPathEndogenes>UI/Icons/Genes/AG_Endogenes</backgroundPathEndogenes>
                <backgroundPathXenogenes>UI/Icons/Genes/AG_Xenogenes</backgroundPathXenogenes>
                <hediffsToBodyPartsOnce>
                    <li>
                        <hediff>OCARINA_MantledBeastsEyesight</hediff>
                        <bodyparts>
                            <li>Eye</li>
                            <li>Eye</li>
                        </bodyparts>
                    </li>
                </hediffsToBodyPartsOnce>
            </li>
        </modExtensions>
    </GeneDef>

    <GeneDef ParentName="GeneJawBase">
        <defName>OCARINA_MantledBeastsJaw</defName>
        <label>va'ji jaw</label>
        <description>Strong, elongated jaw muscles and bone that allow the Va'ji to have the equivalent bite force of a wolf, ranking about 400 PSI.</description>
        <iconPath>UI/Icons/Genes/Gene_MantledBeastsJaw</iconPath>
        <displayOrderInCategory>320</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>0</biostatMet>
        <displayCategory>OCARINA_Cosmetic_MantledBeasts</displayCategory>
        <symbolPack>
            <prefixSymbols>
                <li>
                    <symbol>wolfish</symbol>
                </li>
            </prefixSymbols>
        </symbolPack>
        <modExtensions>
            <li Class="MantledBeasts.GeneExtension">
                <backgroundPathEndogenes>UI/Icons/Genes/AG_Endogenes</backgroundPathEndogenes>
                <backgroundPathXenogenes>UI/Icons/Genes/AG_Xenogenes</backgroundPathXenogenes>
                <hediffsToBodyPartsOnce>
                    <li>
                        <hediff>OCARINA_MantledBeastsJaw</hediff>
                        <bodyparts>
                            <li>Jaw</li>
                        </bodyparts>
                    </li>
                </hediffsToBodyPartsOnce>
            </li>
        </modExtensions>
    </GeneDef>

    <GeneDef>
        <defName>OCARINA_MantledBeastsTemperature</defName>
        <label>va'ji thermophilia</label>
        <description>Carriers of this gene are more comfortable in both hot and cold temperatures.</description>
        <iconPath>UI/Icons/Genes/Gene_MantledBeastsTemperature</iconPath>
        <displayOrderInCategory>20</displayOrderInCategory>
        <statOffsets>
            <ComfyTemperatureMin>-14</ComfyTemperatureMin>
            <ComfyTemperatureMax>14</ComfyTemperatureMax>
        </statOffsets>
        <biostatMet>-3</biostatMet>
        <displayCategory>Temperature</displayCategory>
        <exclusionTags>
            <li>MaxTemperature</li>
            <li>MinTemperature</li>
        </exclusionTags>
    </GeneDef>

</Defs>